# ============================================================
# Carsel Club — Environment Variables
# Copy to .env.local and fill in actual values.
# .env.local is gitignored (per Next.js default).
# ============================================================

# === Database (Postgres) ===
# Local dev (Docker / Homebrew):
#   postgres://carsel:devpass@localhost:5432/carsel_club
# Production (VPS):
#   postgres://carsel_app:STRONGPASS@localhost:5432/carsel_club
DATABASE_URL=postgres://carsel:devpass@localhost:5432/carsel_club

# === WhatsApp Gateway (Sprint 42) ===
# Primary: Wablas (https://wablas.com)
# Get from: Wablas dashboard → API → Token. Endpoint URL is per-account
# (e.g., https://solo.wablas.com/api/send-message — depends on your server zone)
WABLAS_TOKEN=YOUR_WABLAS_TOKEN
WABLAS_API_URL=https://solo.wablas.com/api/send-message
#
# Fallback: Fonnte (legacy, optional — kept for failover selama Wablas
# unproven in production. Drop di Sprint 43 setelah 2 minggu stable Wablas.)
# Get from: fonnte.com → Dashboard → Device Token
FONNTE_TOKEN=

# === Auth ===
# 32+ char secret untuk sign session JWT.
# Generate: openssl rand -base64 32
AUTH_SESSION_SECRET=

# === App ===
# Local dev: http://localhost:3000
# Production: https://carsel.club
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Storage (file uploads) ===
# Absolute path ke storage root.
# Dev:        ./uploads (default kalau kosong)
# Production: /var/www/carsel-uploads (mount Nginx alias — see docs/DEPLOYMENT.md)
UPLOAD_DIR=./uploads

# Public URL prefix yang Nginx (atau dev API route) gunakan.
# Dev/Prod (Nginx alias): /uploads
# Prod dgn CDN:           https://cdn.carsel.club/uploads
NEXT_PUBLIC_UPLOAD_URL_BASE=/uploads

# Max bytes per upload (pre-process). Default 10 MB = 10485760.
MAX_UPLOAD_BYTES=10485760

# === Monitor & Logs (Sprint 2) ===
# Cleanup cron — Bearer token untuk endpoint /api/cron/clean-logs.
# Generate: openssl rand -base64 32
CRON_SECRET=

# Retention sebelum log dihapus (days). Default 30.
LOG_RETENTION_DAYS=30

# === Web Push (Sprint 27) ===
# Generate VAPID key pair sekali:
#   npx web-push generate-vapid-keys
# Public key di-fetch oleh browser via /api/push/vapid-public-key.
# Private key TIDAK boleh expose.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Subject = mailto:admin@yourdomain OR https URL of contact page
VAPID_SUBJECT=mailto:admin@carsel.club

# === Optional: Logging/Analytics ===
# (untuk later, kalau perlu)
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
